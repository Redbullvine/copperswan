# =====================================================================
# The Copper Swan — environment variables
# Copy this file to `.env` for local dev, and set the SAME variables in
# the Netlify dashboard (Site settings → Environment variables) for prod.
# NEVER commit your real .env file. Only .env.example belongs in git.
# =====================================================================

# --- Stripe (required) -----------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
# Use the *test* keys (sk_test_... / pk_test_...) until you go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Publishable key is optional for Checkout redirect, but handy to have.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Sales tax (you have a sales tax license) ------------------------
# When "true", Stripe Tax automatically calculates sales tax at checkout.
# You must first enable Stripe Tax + set your origin address in the
# dashboard: https://dashboard.stripe.com/settings/tax
STRIPE_TAX_ENABLED=true

# --- Storefront settings ---------------------------------------------
# The public base URL of your live site (used for Checkout redirects).
# Leave blank to auto-detect from the incoming request.
SITE_URL=https://copperswan.net

# Currency (ISO code, lowercase). Default: usd
CURRENCY=usd

# Comma-separated 2-letter country codes you ship to. Default: US
SHIP_TO_COUNTRIES=US
